    "main_source": "fn main() {\n    let hs = [f64::from_bits(1), 1e-300, 1e-100, 1e-20, 1e-15, 1e-12, 1e-9, 1e-6, 1e-4, 0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.2, 0.25, 0.4, 0.49, 0.499, 0.49999999999999994];\n    let mut lags=vec![f64::from_bits(1), f64::MIN_POSITIVE, 0.01, 0.1, 1.0, 10.0, 63.99999999999999, 64.0, 64.00000000000001, 80.0, 100000.0, f64::MAX];\n    lags.extend((-323..=308).step_by(9).map(|e|10_f64.powi(e)).filter(|x|x.is_finite() && *x>0.0));\n    let(mut tested,mut none,mut outside)=(0,0,0);\n    let(mut largest,mut max_h,mut max_lag)=(0.0,0.0,0.0);\n    for h in hs { for &lag in &lags {\n        tested+=1;\n        if let Some(value)=probe::fractional_ou_correlation(h,lag) {\n            if value.abs()>largest {largest=value.abs();max_h=h;max_lag=lag;}\n            if value.abs()>1.0+1e-11 {outside+=1;eprintln!(\"out of range: h={h:.17e} lag={lag:.17e} value={value:.17e}\");}\n        } else {none+=1;}\n    }}\n    println!(\"tested={tested} unavailable={none} out_of_range={outside} max_abs={largest:.17e} h={max_h:.17e} lag={max_lag:.17e}\");\n}\n",
