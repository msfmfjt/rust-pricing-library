class StochasticDividendContinuousBarrierPlan:
    """Opt-in frozen-variance physical log-Spot bridge approximation.

    Includes stochastic-reserve variance/correlation and separate cash jumps.
    Explicit finite-bump Spot Delta/Gamma; no generic Greek flags or smoothing.
    Sampling error excludes calibration/time-grid/bridge/bump bias;
    grid refinement is required for the intended contract and market parameters.
    """
    @staticmethod
    def compile_rough_bergomi_lsv(request: PricingRequest, *, hurst: float, vol_of_vol: float, correlation: float, dividend_mean_reversion: float, equity_linkage: float, dividend_volatility: float, equity_dividend_correlation: float, dividend_volatility_correlation: float, particle_count: int, calibration_seed: int, log_bandwidth: float, minimum_effective_samples: float, maximum_step: float, worker_threads: int, reduction_block_size: int | None = None, market_iv_surface: MarketIvSurface | None = None) -> StochasticDividendContinuousBarrierPlan: ...
    @property
    def supports_market_iv_risk(self) -> bool: ...
    def evaluate_bucketed_market_iv_risk(self, *, implied_volatility_bump: float, quote_indices: list[int]) -> StochasticDividendContinuousBarrierBucketedMarketIvRisk:
        """Independently shift selected retained IV quotes and rebuild/recalibrate.

        Unique nonempty row-major quote indices; preserves requested order.
        Three central Vegas at h/2,h,2h, two gaps, and paired selected sums.
        Multiply raw estimates/errors by .01 for per-vol-point reporting.
        """
        ...
    def evaluate_parallel_market_iv_risk(self, *, implied_volatility_bump: float) -> StochasticDividendContinuousBarrierMarketIvRisk:
        """Shift retained residual-forward IV quotes on a half/base/double ladder.

        Rebuilds the original Dupire target and fully recalibrates LSV with
        common seeds/normals. Every shifted quote and target must validate;
        no variance repair, physical-Spot quote conversion or SSVI refit occurs.
        """
        ...
    def evaluate(self) -> StochasticDividendPrice: ...
    def evaluate_spot_bump_risk(self, *, spot_absolute_bump: float | None = None, spot_relative_bump: float | None = None) -> StochasticDividendContinuousBarrierSpotRisk:
        """Paired central price differences for half/base/double Spot bumps.

        Exactly one bump is required. Calibrated leverage values and past hit
        history stay fixed; residual equity and physical Spot are re-anchored.
        Endpoint/jump branches are re-evaluated, including initial equality.
        This is a finite-bump approximation, not an exact derivative guarantee.
        """
        ...
    def evaluate_gamma_bump_risk(self, *, spot_absolute_bump: float | None = None, spot_relative_bump: float | None = None) -> StochasticDividendContinuousBarrierGammaRisk:
        """Paired three-price Gamma on a half/base/double Spot-bump ladder.

        Reuses seven payoffs, including the base-bump central price Delta.
        The same funding, history, branch and uncertainty rules as Spot-bump
        Delta apply. Small bumps can amplify sampling noise and cancellation;
        neither extrapolation nor an exact derivative is provided.
        """
        ...
    def evaluate_parallel_local_volatility_risk(self, *, local_volatility_bump: float) -> StochasticDividendContinuousBarrierLocalVolatilityRisk:
        """Parallel shifts of original residual target sqrt(variance), with full recalibration.

        Absolute volatility bumps use half/base/double widths. Every scenario
        bumps original nodes before refinement, preserves calibration seed/config,
        and re-evolves the pricing path with common shocks. All shifted nodes must
        stay positive, representably changed and within the original floor/cap.
        This is Local-volatility sensitivity, not market-IV Vega or VegaKT.
        """
        ...
    def evaluate_bucketed_local_volatility_risk(self, *, local_volatility_bump: float, node_indices: list[int]) -> StochasticDividendContinuousBarrierBucketedLocalVolatilityRisk:
        """Shift selected original target nodes individually, with six recalibrations per node.

        Unique, nonempty row-major indices follow time_index * x_count + x_index.
        Rows retain selection order; estimates have half/base/double columns.
        Sums include paired covariance and need not equal a parallel finite bump.
        Units are per absolute residual Local volatility, not quoted market IV.
        """
        ...
    def evaluate_reporting_iv_projection(self, *, local_volatility_bump: float, relative_density_threshold: float, full_covariance: bool = False) -> StochasticDividendContinuousBarrierReportingIvRisk:
        """Map all finite Local-volatility node risks onto the model's reporting-IV basis.

        The retained basis must cover every positive original target maturity.
        Density domains and basis stay fixed. Six recalibrations per original node.
        This is the existing residual-LSV reporting map, not quoted-IV bump Vega
        or the complete VegaKT operator. Errors include paired node covariance.
        full_covariance also reports joint covariance of estimated means in
        covariance_labels order, without extra paths or recalibrations.
        """
        ...
    @property
    def plan_fingerprint(self) -> str: ...
    @property
    def time_nodes(self) -> list[float]: ...
    @property
    def random_factor_count(self) -> int: ...
    @property
    def risky_spot(self) -> float: ...
