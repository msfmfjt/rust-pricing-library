class BassMarginal:
    """Continuous finite-support marginal, linear CDF between supplied knots."""
    def __init__(self, expiry: float, spots: Sequence[float], probabilities: Sequence[float]) -> None: ...
    @staticmethod
    def lognormal(expiry: float, spot: float, volatility: float, *, nodes: int = 1601, tail_std: float = 7.0) -> BassMarginal: ...
    @staticmethod
    def from_essvi(expiry: float, spot: float, slices: Sequence[EssviSlice], log_moneyness_nodes: Sequence[float], *, terminal_theta_slope: float = 0.0, tail_probability_tolerance: float = 1e-7, relative_mean_tolerance: float = 1e-4) -> BassMarginalProjection: ...
    @property
    def expiry(self) -> float: ...
    @property
    def mean(self) -> float: ...
    @property
    def variance(self) -> float: ...
    @property
    def spots(self) -> list[float]: ...
    @property
    def probabilities(self) -> list[float]: ...
    def cdf(self, spot: float) -> float: ...
    def quantile(self, probability: float) -> float: ...
    def call_price(self, strike: float) -> float: ...

