{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rust-pricing-library:schema:v1:pricing_request",
  "title": "PricingRequest schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_kind", "schema_version", "valuation_date", "product", "market", "model", "engine", "risk"],
  "properties": {
    "document_kind": {"type": "string", "const": "pricing_request"},
    "schema_version": {"const": 1},
    "valuation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "product": {"$ref": "#/$defs/product"},
    "market": {"$ref": "#/$defs/market"},
    "model": {"$ref": "#/$defs/model"},
    "engine": {"$ref": "#/$defs/engine"},
    "risk": {"$ref": "#/$defs/risk"}
  },
  "$defs": {
    "side": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "call"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "put"}}}
      ]
    },
    "product": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "underlying_id", "currency_id", "expiry", "strike", "notional", "side"],
          "properties": {
            "type": {"type": "string", "const": "european_vanilla"}, "underlying_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "currency_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "expiry": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "strike": {"type": "number", "exclusiveMinimum": 0}, "notional": {"type": "number", "exclusiveMinimum": 0}, "side": {"$ref": "#/$defs/side"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "underlying_id", "currency_id", "expiry", "strike", "payout", "side", "payout_kind"],
          "properties": {
            "type": {"type": "string", "const": "digital"}, "underlying_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "currency_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "expiry": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "strike": {"type": "number", "exclusiveMinimum": 0}, "payout": {"type": "number", "exclusiveMinimum": 0},
            "side": {"$ref": "#/$defs/side"}, "payout_kind": {"$ref": "#/$defs/digital_payout"},
            "payment_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "underlying_id", "currency_id", "expiry", "strike", "barrier", "notional", "side", "direction", "style", "monitoring_dates", "payment_date"],
          "properties": {
            "type": {"type": "string", "const": "barrier"}, "underlying_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "currency_id": {"type": "integer", "minimum": 0, "maximum": 65535}, "expiry": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "strike": {"type": "number", "exclusiveMinimum": 0}, "barrier": {"type": "number", "exclusiveMinimum": 0},
            "notional": {"type": "number", "exclusiveMinimum": 0}, "side": {"$ref": "#/$defs/side"},
            "direction": {"$ref": "#/$defs/barrier_direction"}, "style": {"$ref": "#/$defs/barrier_style"},
            "monitoring_dates": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
            "rebate": {"type": "number", "exclusiveMinimum": 0},
            "payment_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "underlying_id", "currency_id", "strike", "notional", "side", "observations", "payment_date"],
          "properties": {
            "type": {"type": "string", "const": "arithmetic_asian"}, "underlying_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "currency_id": {"type": "integer", "minimum": 0, "maximum": 65535},
            "strike": {"type": "number", "exclusiveMinimum": 0}, "notional": {"type": "number", "exclusiveMinimum": 0},
            "side": {"$ref": "#/$defs/side"}, "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asian_observation"}},
            "payment_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "underlying_id", "currency_id", "strike", "notional", "side", "monitoring_dates", "payment_date"],
          "properties": {
            "type": {"type": "string", "const": "fixed_lookback"}, "underlying_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "currency_id": {"type": "integer", "minimum": 0, "maximum": 65535},
            "strike": {"type": "number", "exclusiveMinimum": 0}, "notional": {"type": "number", "exclusiveMinimum": 0},
            "side": {"$ref": "#/$defs/side"}, "monitoring_dates": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
            "historical_extremum": {"type": "number", "exclusiveMinimum": 0},
            "payment_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        }
      ]
    },
    "asian_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "weight", "value"],
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "weight": {"type": "number", "minimum": 0},
        "value": {"$ref": "#/$defs/asian_observation_value"}
      }
    },
    "asian_observation_value": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "fixing"], "properties": {"type": {"type": "string", "const": "known"}, "fixing": {"type": "number", "exclusiveMinimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "unknown"}}}
      ]
    },
    "digital_payout": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "cash"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "asset"}}}
      ]
    },
    "barrier_direction": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "up"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "down"}}}
      ]
    },
    "barrier_style": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "knock_in"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "knock_out"}}}
      ]
    },
    "curve": {
      "type": "object", "additionalProperties": false, "required": ["curve_id", "times", "discount_factors"],
      "properties": {
        "curve_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "times": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}},
        "discount_factors": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "market": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "currency_id", "underlying_id", "spot", "discount_curve", "dividend_curve"],
      "properties": {
        "type": {"type": "string", "const": "equity"}, "currency_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "underlying_id": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "spot": {"type": "number", "exclusiveMinimum": 0},
        "discount_curve": {"$ref": "#/$defs/curve"}, "dividend_curve": {"$ref": "#/$defs/curve"},
        "discrete_dividends": {"type": "array", "items": {"$ref": "#/$defs/dividend_event"}}
      }
    },
    "dividend_event": {
      "type": "object", "additionalProperties": false, "required": ["event_id", "ex_time", "quote"],
      "properties": {
        "event_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "ex_time": {"type": "number", "minimum": 0},
        "quote": {"$ref": "#/$defs/dividend_quote"}
      }
    },
    "dividend_quote": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "amount"], "properties": {"type": {"type": "string", "const": "fixed_cash"}, "amount": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "beta"], "properties": {"type": {"type": "string", "const": "proportional"}, "beta": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "fixed_cash", "beta"], "properties": {"type": {"type": "string", "const": "fixed_cash_and_proportional"}, "fixed_cash": {"type": "number", "minimum": 0}, "beta": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}}
      ]
    },
    "model": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "volatility"], "properties": {"type": {"type": "string", "const": "black_scholes"}, "volatility": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "volatility"], "properties": {"type": {"type": "string", "const": "black_76"}, "volatility": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "local_variance_grid"], "properties": {"type": {"type": "string", "const": "local_volatility"}, "local_variance_grid": {"$ref": "#/$defs/local_variance_grid"}, "reporting_iv_basis": {"$ref": "#/$defs/reporting_iv_basis"}}}
      ]
    },
    "local_variance_grid": {
      "type": "object", "additionalProperties": false,
      "required": ["time_nodes", "log_forward_moneyness_nodes", "shape", "values", "floor", "cap"],
      "properties": {
        "time_nodes": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "log_forward_moneyness_nodes": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 2, "maximum": 18446744073709551615}},
        "values": {"type": "array", "minItems": 4, "items": {"type": "number", "exclusiveMinimum": 0}},
        "floor": {"type": "number", "minimum": 0},
        "cap": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "reporting_iv_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["maturity_nodes", "log_forward_moneyness_nodes", "shape", "implied_volatilities"],
      "properties": {
        "maturity_nodes": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "log_forward_moneyness_nodes": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 2, "maximum": 18446744073709551615}},
        "implied_volatilities": {"type": "array", "minItems": 4, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "variance_reduction": {
      "type": "object", "additionalProperties": false, "required": ["antithetic", "brownian_bridge"],
      "properties": {"antithetic": {"type": "boolean"}, "brownian_bridge": {"type": "boolean"}}
    },
    "engine": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "master_seed", "independent_sampling_units", "variance_reduction"], "properties": {"type": {"type": "string", "const": "pseudo_monte_carlo"}, "master_seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "independent_sampling_units": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}, "variance_reduction": {"$ref": "#/$defs/variance_reduction"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "points_per_scramble", "scramble_count", "master_scramble_seed", "variance_reduction"], "properties": {"type": {"type": "string", "const": "randomized_quasi_monte_carlo"}, "points_per_scramble": {"type": "integer", "minimum": 1, "maximum": 4294967296}, "scramble_count": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "master_scramble_seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "variance_reduction": {"$ref": "#/$defs/variance_reduction"}}}
      ]
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["delta", "vega", "smile_dynamics"],
      "properties": {
        "delta": {"type": "boolean"}, "vega": {"type": "boolean"},
        "gamma": {"$ref": "#/$defs/gamma"},
        "vega_kt": {"$ref": "#/$defs/vega_kt"},
        "smile_dynamics": {"$ref": "#/$defs/smile_dynamics"},
        "checkpoint_interval": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "aad_tile_capacity": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "gamma": {
      "type": "object", "additionalProperties": false, "required": ["bump"],
      "properties": {"bump": {"$ref": "#/$defs/spot_bump"}}
    },
    "spot_bump": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string", "const": "absolute"}, "value": {"type": "number", "exclusiveMinimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"type": "string", "const": "relative"}, "value": {"type": "number", "exclusiveMinimum": 0}}}
      ]
    },
    "vega_kt": {
      "type": "object", "additionalProperties": false,
      "required": ["maturity_nodes", "log_forward_moneyness_nodes", "relative_density_threshold", "full_bucket_covariance"],
      "properties": {
        "maturity_nodes": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
        "log_forward_moneyness_nodes": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "relative_density_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "full_bucket_covariance": {"type": "boolean"}
      }
    },
    "smile_dynamics": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "sticky_log_moneyness"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "sticky_strike"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "const": "sticky_delta"}}}
      ]
    }
  }
}
